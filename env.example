# Copy this file to .env and fill in the values: cp env.example .env
# The .env file is ignored by git: never commit secrets.

# --- Django ---

# Debug mode: True for local development only, never in production.
DJANGO_DEBUG=True

# Secret key. Optional when DJANGO_DEBUG=True, required otherwise.
# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Host names allowed to serve the site, separated by commas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Sentry ---

# Sentry DSN (Sentry > Settings > Projects > oc-lettings > Client Keys (DSN)).
# Leave empty to disable Sentry.
SENTRY_DSN=

# Environment name shown in Sentry (development, production...).
SENTRY_ENVIRONMENT=development

# Share of requests traced for performance monitoring (0 = disabled, 1 = all).
SENTRY_TRACES_SAMPLE_RATE=0

# --- Logging ---

# Log level of the lettings, profiles and oc_lettings_site loggers.
LOG_LEVEL=INFO
