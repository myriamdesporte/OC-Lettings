# Copy this file to .env and fill in the values: cp env.example .env
# The .env file is ignored by git: never commit secrets.

# Sentry DSN (Sentry > Settings > Projects > oc-lettings > Client Keys (DSN)).
# Leave empty to disable Sentry.
SENTRY_DSN=

# Environment name shown in Sentry (development, production...).
SENTRY_ENVIRONMENT=development

# Share of requests traced for performance monitoring (0 = disabled, 1 = all).
SENTRY_TRACES_SAMPLE_RATE=0

# Log level of the lettings, profiles and oc_lettings_site loggers.
LOG_LEVEL=INFO
